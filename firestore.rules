rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAgent() {
      return signedIn() && request.auth.token.agent == true;
    }

    match /insuranceSubmissions/{recordId} {
      allow read: if isAgent() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isAgent() || (signedIn() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAgent() ||
        (signedIn() &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAgent() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
  }
}
