rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAgent() {
      return signedIn() && request.auth.token.get('agent', false) == true;
    }

    function isAnonymousGuest() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    match /insuranceSubmissions/{recordId} {
      allow read: if isAgent() || owns(resource.data);
      allow create: if isAgent() || (isAnonymousGuest() && owns(request.resource.data)) || owns(request.resource.data);
      allow update: if isAgent() ||
        (owns(resource.data) && owns(request.resource.data));
      allow delete: if isAgent() || owns(resource.data);
    }
  }
}
